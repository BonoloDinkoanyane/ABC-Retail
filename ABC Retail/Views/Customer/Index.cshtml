@model IEnumerable<ABC_Retail.Models.Customer>

<h1>Customers</h1>

<a class="btn btn-primary" asp-action="Create">Add a new customer</a>

<a class="btn btn-info" asp-action="Log">View Log</a>

<table class="table">
	<thead>
		<tr>
			<th>Name</th>
			<th>Email</th>
			<th>Phone Number</th>
			<th>Address</th>
			<th>Manage</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var customer in Model)
		{
			<tr>
				<td>@customer.Name</td>
				<td>@customer.Email</td>
				<td>@customer.PhoneNumber</td>
				<td>@customer.Address</td>
				<td>
					<a class="btn btn-info" asp-action="Details" asp-route-partitionKey="@customer.PartitionKey" asp-route-rowKey="@customer.RowKey">Details</a>
					<a class="btn btn-warning" asp-action="Edit" asp-route-partitionKey="@customer.PartitionKey" asp-route-rowKey="@customer.RowKey">Edit</a>
					<a class="btn btn-danger" asp-action="Delete" asp-route-partitionKey="@customer.PartitionKey" asp-route-rowKey="@customer.RowKey">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>