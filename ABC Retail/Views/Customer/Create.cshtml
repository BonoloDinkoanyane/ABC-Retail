@model ABC_Retail.Models.Customer

<h2>Create Customer</h2>

<form asp-action="Create" method="post">
    <!--below hide partition aand row key methods from chat gpt
        language model 5.0
        accessed on 28august 2025
        https://chatgpt.com/share/68b0d961-96e0-8002-a23b-0372a2d046f7
    --> 
    <div class="form-group">
        <input asp-for="PartitionKey" type="hidden" />
    </div> 
    <div class="form-group">
        <input asp-for="RowKey" type="hidden" />
    </div>
    <div class="form-group">
        <label asp-for="Name">Customer name: </label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Email">Customer email: </label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="PhoneNumber">Customer Phone Number:</label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Address">Customer Address:</label>
        <input asp-for="Address" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Create</button>
    <a class="btn btn-secondary mt-2" asp-action="Index">Cancel</a>
</form>
